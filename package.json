{
  "name": "dsh-figma-designer",
  "version": "0.9.1",
  "private": true,
  "description": "Natural-language Figma design editing for DeepSeek Harness: typed canvas operations, dry-run previews, screenshots in the loop, and a one-time paired Figma companion plugin.",
  "icon": "./icon.svg",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "lib/*.js",
    "companion/code.js",
    "companion/ui.html",
    "locale/*.json",
    "skills/figma-designer/**",
    "skills/figma-design/**"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-locale"
      ]
    }
  }
}

{
  "name": "dsh-figma-designer",
  "version": "0.7.0",
  "description": "Natural-language Figma design editing and design-quality workflow for DeepSeek Harness: typed canvas operations, screenshots, design-system tools, and an independent review loop.",
  "icon": "./icon.svg",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "lib/*.js",
    "companion/code.js",
    "companion/ui.html",
    "locale/*.json",
    "skills/figma-designer/**",
    "skills/figma-design/**"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-locale"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "figma",
    "design-system",
    "codegen",
    "figma-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lnowave/dsh-figma-designer.git"
  },
  "homepage": "https://github.com/lnowave/dsh-figma-designer#readme",
  "bugs": {
    "url": "https://github.com/lnowave/dsh-figma-designer/issues"
  }
}
